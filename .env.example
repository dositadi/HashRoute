#server 
HOST=0.0.0.0
PORT=8080
# where short links are served from; used to build `short_url` in responses
PUBLIC_BASE_URL=http://localhost:8080

# jwt 
JWT_SECRET=
ACCESS_EXP=54000
REFRESH_TOKEN_EXP=36288000

# cors (comma-separated; origins need a scheme and no trailing slash, or `*`)
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOW_HEADERS=authorization,content-type,x-refresh
ALLOW_METHODS=GET,POST,OPTIONS

#Postgres Env Vars
PG_SCHEME=postgres
PG_PASSWORD=
PG_USER=divine
PG_DB=hash_db
PG_HOST=db
PG_PORT=5432
PG_MAX_CONN=10
PG_ACQUIRE_TIMEOUT=3
PG_IDLE_TIMEOUT=4